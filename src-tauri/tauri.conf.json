{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plume",
  "version": "0.1.4",
  "identifier": "dev.plume.launcher",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Plume", "width": 900, "height": 600, "minWidth": 700, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.modrinth.com; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1RTdENDA1QTE3M0QzRTkKUldUcDAzT2hCZFRuaFNQVmVtaVJVNGlwcUJFa0ZKVmFYc2UzUE91QkdPb3VaZk1nNDFtbnRTSzEK",
      "endpoints": ["https://github.com/lefilou20contact-ai/plume-launcher/releases/latest/download/latest.json"]
    }
  }
}
